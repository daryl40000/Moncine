# Base de données locale (ne pas versionner vos films)
/data/*.db
/data/*.db-journal

# Secrets et données sensibles (hors dépôt Git)
/data/tmdb_api_key.txt
/data/omdb_api_key.txt
/data/.keys/
/data/auth_rate_limit/
/data/sessions/*
!/data/sessions/.gitkeep

# Affiches téléchargées (fichiers générés)
/www/posters/*
!/www/posters/.gitkeep

# Graine d’installation (données personnelles — ne pas versionner)
/install_seed/*.csv
/install_seed/*.zip
/install_seed/*.ods
/data/install_seed/
/data/share_rate_limit/

# Fichiers médias volumineux (PDF, exports…)
/data/media/

# Fichiers système
.DS_Store
Thumbs.db

# Dépendances PHP (tests)
/vendor/
/.phpunit.cache/
/composer.phar

# Éditeurs
.idea/
.vscode/
*.swp
